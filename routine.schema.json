{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayspec.local/routine.schema.json",
  "title": "dayspec routine",
  "description": "The template library and shared settings for Dayspec.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templates"
  ],
  "properties": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day_starts_at": {
          "$ref": "#/$defs/time",
          "description": "Before this time the app still shows the previous day; earlier times sort last. Default 04:00."
        },
        "holiday_template": {
          "$ref": "#/$defs/id",
          "description": "Template used on holidays. Without a selection, use the regular weekday template."
        },
        "automatic_swedish_holidays": {
          "type": "boolean",
          "description": "Use the Swedish public holiday calendar for dates without a manual override. Default true."
        },
        "calendar": {
          "type": "string",
          "enum": [
            "google"
          ],
          "description": "Calendar used when adding an activity or block. Default google."
        }
      }
    },
    "categories": {
      "type": "object",
      "description": "Item categories, keyed by stable ID, in the order the editor lists them.",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "color"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "$ref": "#/$defs/color"
          }
        }
      }
    },
    "blocks": {
      "type": "object",
      "description": "Reusable sequences of duration-based activities and other shared blocks. Timing and conditional branches belong to templates.",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "items"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "$ref": "#/$defs/id",
            "description": "Key of a category in `categories`; the block's colour and the default for its items."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/shared_entry"
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "description": "Day templates, keyed by stable ID.",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s/?#]+"
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "weekday": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "weekdays": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/weekday"
      }
    },
    "color": {
      "enum": [
        "orange",
        "yellow",
        "green",
        "teal",
        "blue",
        "indigo",
        "violet",
        "pink",
        "red",
        "gray"
      ],
      "description": "A colour from the app's palette, tuned for its dark theme."
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "items"
      ],
      "properties": {
        "on": {
          "$ref": "#/$defs/weekdays"
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/choice"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/option"
          }
        },
        "default": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/weekday"
              },
              "additionalProperties": {
                "$ref": "#/$defs/id"
              }
            }
          ]
        }
      },
      "required": [
        "options",
        "default"
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "only_on": {
          "$ref": "#/$defs/weekdays"
        }
      }
    },
    "entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/item"
        },
        {
          "$ref": "#/$defs/use"
        },
        {
          "$ref": "#/$defs/branch"
        }
      ]
    },
    "activity": {
      "type": "object",
      "description": "Fields shared by template activities and shared-block activities.",
      "required": [
        "title",
        "duration"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "description": "Duration in minutes."
        },
        "category": {
          "$ref": "#/$defs/id",
          "description": "Key of a category in `categories`; sets the item's colour."
        },
        "alert": {
          "type": "boolean",
          "description": "Marks the item with a bell on the timeline."
        },
        "link": {
          "$ref": "#/$defs/url"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "item": {
      "description": "An activity at a start time.",
      "$ref": "#/$defs/activity",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/time"
        },
        "approx": {
          "type": "boolean",
          "description": "Show the time as approximate (≈)."
        }
      },
      "unevaluatedProperties": false
    },
    "block_ref": {
      "type": "object",
      "required": [
        "use"
      ],
      "properties": {
        "use": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "use": {
      "description": "Places a shared block at a start time.",
      "$ref": "#/$defs/block_ref",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/time"
        },
        "approx": {
          "type": "boolean",
          "description": "Show the block's times as approximate (≈)."
        }
      },
      "unevaluatedProperties": false
    },
    "branch": {
      "type": "object",
      "description": "Follows the path of the option selected for one of the template's choices. Missing or empty paths add nothing.",
      "additionalProperties": false,
      "required": [
        "choice",
        "paths"
      ],
      "properties": {
        "choice": {
          "$ref": "#/$defs/id"
        },
        "paths": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/entry"
            }
          }
        }
      }
    },
    "shared_entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/shared_item"
        },
        {
          "$ref": "#/$defs/shared_use"
        }
      ]
    },
    "shared_item": {
      "description": "A duration-based activity inside a shared block.",
      "$ref": "#/$defs/activity",
      "unevaluatedProperties": false
    },
    "shared_use": {
      "description": "Includes another shared block.",
      "$ref": "#/$defs/block_ref",
      "unevaluatedProperties": false
    }
  }
}
